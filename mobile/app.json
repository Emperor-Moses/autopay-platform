{
  "expo": {
    "name": "AutoPay",
    "slug": "autopay-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c140c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.autopay.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "AutoPay uses the camera to scan account details.",
        "NSFaceIDUsageDescription": "AutoPay uses Face ID to secure your account.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ng.autopay.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c140c"
      }
    },
    "extra": {
      "apiUrl": "https://autopay-platform.onrender.com/api/v1",
      "eas": {
        "projectId": "34895f17-fca6-470d-8ce0-fc30ef6ee730"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
